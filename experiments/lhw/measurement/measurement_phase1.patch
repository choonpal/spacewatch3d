+def legacy_clean_points(points):
+    """Frozen pre-phase1 algorithm, for behavioral comparisons only."""
+    p=np.asarray(points,float)
+    if len(p)<32:return p,1.
+    q=np.quantile(p,[.01,.99],axis=0);diagonal=np.linalg.norm(q[1]-q[0])
+    voxel=max(diagonal/60,1e-8)
+    _,ids=np.unique(np.floor(p/voxel).astype(np.int64),axis=0,return_index=True)
+    sample=p[ids];tree=cKDTree(sample)
+    pairs=tree.query_pairs(voxel*3.2,output_type='ndarray')
+    graph=coo_matrix((np.ones(len(pairs)),(pairs[:,0],pairs[:,1])),shape=(len(sample),len(sample)))
+    _,labels=connected_components(graph,directed=False)
+    counts=np.bincount(labels);main=counts.argmax()
+    _,near=tree.query(p,k=1)
+    keep=labels[near]==main
+    return p[keep],float(keep.mean())
+
+
+def separated_parts():
+    rng=np.random.default_rng(11)
+    major=rng.uniform([0,0,0],[.6,.5,.8],(6000,3))
+    part=rng.uniform([.68,.2,0],[.85,.4,.4],(700,3))
+    noise=rng.uniform([5,5,5],[6,6,6],(8,3))
+    return np.vstack([major,part,noise])
+
+
+class CleaningTests(unittest.TestCase):
+    def test_preserves_disconnected_part_but_not_reference(self):
+        p=separated_parts()
+        old,_=legacy_clean_points(p)
+        clean,fraction,info=clean_points(p,return_info=True)
+        self.assertGreater(len(clean),len(old))
+        self.assertGreater(dimensions(clean)[1],dimensions(old)[1])
+        self.assertFalse((clean[:,0]>4).any())
+        self.assertGreaterEqual(info['components_kept'],2)
+        self.assertTrue(info['measurement_uncertain'])
+        self.assertEqual(info['retained_points'],len(clean))
+        self.assertAlmostEqual(fraction,len(clean)/len(p))
+        reasons=projection.reference_rejection_reasons(
+            dict(border_touch=False,outside_box_fraction=0),.2,'chair',[],info)
+        self.assertIn('multiple_spatial_components',reasons)
