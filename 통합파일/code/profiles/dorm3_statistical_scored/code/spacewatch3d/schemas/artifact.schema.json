        },
        "source_frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_s": {
          "type": "number",
          "minimum": 0
        },
        "view_id": {
          "type": "string",
          "minLength": 1
        },
        "image_uri": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
