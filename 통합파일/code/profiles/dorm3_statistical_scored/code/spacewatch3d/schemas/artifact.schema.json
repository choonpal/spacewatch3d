        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "capture_id": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "boolean"
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "source_manifest": {
          "type": "string",
          "minLength": 1
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
