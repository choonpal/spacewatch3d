+"""Evidence v2: provisional geometry proposals and supported IDs are separate.
+
+Legacy bounded topology supplies hypotheses, NOT physical truth. No distance-
+only gap merges, no unstable neck cuts, no promotion of partial size to truth.
+"""
+import numpy as np
+from scipy.spatial import cKDTree
+from .size_geometry import solve,geometry
+from .instance_evidence import (KINDS,options,references,extent,solve_evidence)
+
+
+def proposal_ids(result):
+    """Consumers may display proposals; they must never substitute for IDs."""
+    return result['proposal_ids']
+
+
+def supported_regions(regions):
+    """Only identity-supported regions can become per-object planning targets."""
+    return [r for r in regions if r['kind']=='object_candidate' and
+            r.get('identity_status')=='supported_by_multiframe_seed' and r.get('seed_candidate_id')]
+
+
+def boundary(v,f,fi,area,normals):
+    ff=f[fi];edges=np.sort(ff[:,[[0,1],[1,2],[2,0]]].reshape(-1,2),axis=1)
+    unique,count=np.unique(edges,axis=0,return_counts=True);be=unique[count==1]
+    if not len(be):return None
+    vv=np.unique(be);seam=fi[np.isin(f[fi],vv).any(axis=1)]
+    n=np.average(normals[seam],axis=0,weights=np.maximum(area[seam],1e-30))
+    lengths=np.linalg.norm(v[be[:,0]]-v[be[:,1]],axis=1)
+    return dict(vertices=vv,normal=n,perimeter=float(lengths.sum()))
+
+
+def fits_upper(v,f,fi,upper):
+    """Match the legacy any-yaw envelope, not just minimum-area yaw.
+
+    A minimum-area orientation can violate the long-axis cap even when a
+    different orientation satisfies both caps. This is not cap relaxation.
+    """
+    points=v[np.unique(f[fi])]
+    if np.ptp(points[:,2])>upper[2]+1e-6:return False
+    for angle in np.deg2rad(np.arange(0,90,7.5)):
+        c,s=np.cos(angle),np.sin(angle)
+        spans=np.ptp(points[:,:2]@np.array([[c,-s],[s,c]]),axis=0)
+        if np.sort(spans)[0]<=upper[0]+1e-6 and np.sort(spans)[1]<=upper[1]+1e-6:return True
+    return False
+
+
+def solve_proposals(v,f,priors,settings,semantic,factor=1.,seed_spec=None,frame_id=None,coordinates_sha256=None):
+    v=np.asarray(v);f=np.asarray(f);labels=np.asarray(semantic)
+    opt=options(settings);centers,normals,area=geometry(v,f)
+    # Keep the legacy upper envelopes and priority, but eliminate fixed-k gap
+    # edges. Face count and lower-size tests no longer erase partial proposals.
+    base=solve(v,f,priors,settings,semantic=labels,factor=factor,allow_gap_merges=False)
+    refs={p['class_id']:references(p,settings,factor) for p in priors}
+    proposals=[];pids=np.zeros(len(f),np.uint32);bounds={};parts={}
+    for row in base['regions']:
+        fi=np.flatnonzero(base['ids']==row['id']);cid=int(labels[fi[0]])
+        if cid not in refs or area[fi].sum()<opt['minimum_area']:continue
+        dims,raw=extent(v,f,fi,area,opt['trim_fraction'])
+        upper=[r for r in refs[cid] if fits_upper(v,f,fi,r['upper'])]
+        if not upper:continue
+        complete=[r for r in upper if (np.sort(dims)[-2:]>=np.sort(r['lower'])[-2:]).all()]
+        pid=len(proposals)+1;pids[fi]=pid;parts[pid]=fi
+        reasons=['physical_identity_unverified_no_seed'] if seed_spec is None else []
+        if not complete:reasons.append('partial_surface_below_reference_support')
+        if (raw>np.maximum(dims,1e-9)*opt['outlier_extent_ratio']).any():reasons.append('outlier_or_thin_protrusion_extent')
+        p=dict(row,id=pid,proposal_id=pid,source_region_id=row['id'],kind='provisional',class_id=cid,
+            identity_status='provisional',physical_instance_verified=False,observed_dimensions=dims.tolist(),
+            raw_observed_dimensions=raw.tolist(),size_candidate_eligible=True,
+            dimension_source='area_weighted_visible_surface_quantiles',full_physical_size_measured=False,
+            size_support_status='object_scale_surface' if complete else 'partial_surface',
+            grouping_evidence='size_bounded_topology_no_gap',decision_reasons=reasons,
+            reference_ranges=[dict(id=r['id'],scope=r['source'],verified=r['verified'],dimensions=r['dimensions'].tolist(),
+                                   lower=r['lower'].tolist(),upper=r['upper'].tolist()) for r in refs[cid]],
+            assembly_links=[],supported_instance_ids=[])
+        proposals.append(p);bounds[pid]=boundary(v,f,fi,area,normals)
+    # Gap relationships are audited as alternatives. Ambiguous proximity does
+    # not silently collapse proposal IDs. Real validated seed assembly below
+    # is the only route that can strengthen physical correspondence.
+    links=[]
+    for i,a in enumerate(proposals):
+        if bounds[a['id']] is None:continue
+        for b in proposals[:i]:
+            if a['class_id']!=b['class_id'] or bounds[b['id']] is None:continue
+            ba,bb=bounds[a['id']],bounds[b['id']]
+            distance=float(cKDTree(v[ba['vertices']]).query(v[bb['vertices']])[0].min())
+            if distance>settings['max_gap']:continue
+            denom=np.linalg.norm(ba['normal'])*np.linalg.norm(bb['normal'])
+            normal_agreement=float(abs(ba['normal']@bb['normal'])/denom) if denom>1e-12 else None
+            joined=np.r_[parts[a['id']],parts[b['id']]];dim,full=extent(v,f,joined,area,opt['trim_fraction'])
+            upper_fit=any(fits_upper(v,f,joined,r['upper']) for r in refs[a['class_id']])
+            compatible=normal_agreement is not None and normal_agreement>=np.cos(np.deg2rad(opt['gap_normal_degrees'])) and upper_fit
+            reason='two_object_scale_surfaces' if a['size_support_status']==b['size_support_status']=='object_scale_surface' else 'possible_fragment_assembly_requires_observation' if compatible else 'boundary_or_extent_inconsistent'
+            link=dict(proposal_ids=[a['id'],b['id']],distance=distance,boundary_normal_agreement=normal_agreement,
+                      joined_observed_dimensions=dim.tolist(),joined_upper_fit=upper_fit,reason=reason,merged=False)
+            links.append(link);a['assembly_links'].append(len(links)-1);b['assembly_links'].append(len(links)-1)
+    supported=None
+    if seed_spec is not None:
+        # Preserve the existing seed contract, suppress only unstable cuts.
+        supported=solve_evidence(v,f,priors,settings,labels,factor,seed_spec,frame_id,coordinates_sha256,
+                                 diagnostic_only_narrow=True)
+    ids=np.zeros(len(f),np.uint32);kinds=np.zeros(len(f),np.uint8);regions=[]
+    def add(fi,row,kind):
+        rid=len(regions)+1;ids[fi]=rid;kinds[fi]=KINDS.index(kind)
+        points=v[np.unique(f[fi])];row=dict(row,id=rid,kind=kind,faces=len(fi),area=float(area[fi].sum()),
+            bounds=[points.min(0).tolist(),points.max(0).tolist()],
+            centroid=np.average(centers[fi],axis=0,weights=np.maximum(area[fi],1e-30)).tolist(),
+            proposal_ids=np.unique(pids[fi][pids[fi]>0]).astype(int).tolist())
+        regions.append(row)
+        if kind=='object_candidate':
+            for pid in row['proposal_ids']:proposals[pid-1]['supported_instance_ids'].append(rid)
+    if supported:
+        for row in supported['regions']:
+            if row['kind']=='object_candidate':add(np.flatnonzero(supported['ids']==row['id']),row,'object_candidate')
+    for row in base['regions']:
+        fi=np.flatnonzero((base['ids']==row['id'])&(ids==0))
+        if not len(fi):continue
+        pid=int(pids[fi[0]])
+        if pid:
+            record=dict(proposals[pid-1]);kind='uncertain'
+        else:record=dict(row,identity_status='unresolved',decision_reasons=['insufficient_surface_area_or_reference_scope'],physical_instance_verified=False);kind=row['kind'] if row['kind']!='object_candidate' else 'fragment'
+        add(fi,record,kind)
+    assert (ids>0).all() and sum(r['faces'] for r in regions)==len(f)
+    return dict(ids=ids,kinds=kinds,regions=regions,proposals=proposals,proposal_ids=pids,
+        counts={k:sum(r['kind']==k for r in regions) for k in KINDS},
+        coverage={k:dict(faces=int((kinds==i).sum()),area=float(area[kinds==i].sum())) for i,k in enumerate(KINDS)},
+        faces=len(f),all_faces_assigned=True,semantic_labels_used=True,factor=factor,
+        audit=dict(mode='evidence_v2',proposal_count=len(proposals),gap_links=links,automatic_unseeded_gap_merges=0,
+                   unstable_narrow_cuts_applied=0,lower_size_is_diagnostic_only=True,
+                   physical_accuracy_measured=False,seed_audit=supported['audit'] if supported else None))
