    "video": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "kind": {
          "const": "video"
        },
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "capture_id": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "boolean"
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "source_video_uri": {
          "type": "string",
          "minLength": 1
        },
        "projection": {
          "enum": [
            "perspective",
            "equirectangular"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "schema_version",
        "kind",
        "scene_id",
        "capture_id",
        "synthetic",
        "producer",
        "parameters",
        "source_video_uri",
        "projection",
        "width",
        "height"
      ],
      "additionalProperties": false
