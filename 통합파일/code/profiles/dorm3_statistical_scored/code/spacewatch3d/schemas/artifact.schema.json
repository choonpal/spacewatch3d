{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SpaceWatch3D artifact contract 0.1.0",
  "oneOf": [
    {
      "$ref": "#/$defs/video"
    },
    {
      "$ref": "#/$defs/frames"
    },
    {
      "$ref": "#/$defs/reconstruction"
    },
    {
      "$ref": "#/$defs/instances"
    },
    {
      "$ref": "#/$defs/objects"
    },
    {
      "$ref": "#/$defs/changes"
    },
    {
      "$ref": "#/$defs/keyframes"
    }
  ],
  "$defs": {
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "matrix3": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "minItems": 3,
      "maxItems": 3
    },
    "matrix4": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 4,
        "maxItems": 4
      },
      "minItems": 4,
      "maxItems": 4
    },
    "intrinsics": {
      "type": "object",
      "properties": {
        "fx": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fy": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cx": {
          "type": "number"
        },
        "cy": {
          "type": "number"
        }
      },
      "required": [
        "fx",
        "fy",
        "cx",
        "cy"
      ],
      "additionalProperties": false
    },
    "coordinates": {
      "type": "object",
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "handedness": {
          "const": "right"
        },
        "up_axis": {
          "enum": [
            "unknown",
            "+Y",
            "-Y",
            "+Z"
          ]
        },
        "units": {
          "enum": [
            "m",
            "arbitrary"
          ]
        },
        "scale_to_meters": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "frame_id",
        "handedness",
        "up_axis",
        "units",
        "scale_to_meters"
      ],
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp_s": {
          "type": "number",
          "minimum": 0
        },
        "source_frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "view_id": {
          "type": "string",
          "minLength": 1
        },
        "image_uri": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "intrinsics": {
          "anyOf": [
            {
              "$ref": "#/$defs/intrinsics"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_from_view_rotation": {
          "$ref": "#/$defs/matrix3"
        }
      },
      "required": [
        "frame_id",
        "timestamp_s",
        "source_frame_index",
        "view_id",
        "image_uri",
        "width",
        "height",
        "intrinsics",
        "source_from_view_rotation"
      ],
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "image_uri": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "intrinsics": {
          "$ref": "#/$defs/intrinsics"
        },
        "world_from_camera": {
          "$ref": "#/$defs/matrix4"
        },
        "depth_uri": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence_uri": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "depth_convention": {
          "enum": [
            "camera_z",
            null
          ]
        }
      },
      "required": [
        "frame_id",
        "image_uri",
        "width",
        "height",
        "intrinsics",
        "world_from_camera",
        "depth_uri",
        "confidence_uri",
        "depth_convention"
      ],
      "additionalProperties": false
    },
    "instance": {
      "type": "object",
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "class_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "class_confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "point_count": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_frame_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "instance_id",
        "class_name",
        "class_confidence",
        "confidence",
        "point_count",
        "evidence_frame_ids"
      ],
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "mesh_uri": {
          "type": "string",
          "minLength": 1
        },
        "mesh_format": {
          "enum": [
            "glb",
            "obj"
          ]
        },
        "material_uri": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "texture_uris": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "world_from_object": {
          "$ref": "#/$defs/matrix4"
        },
        "bbox_min": {
          "$ref": "#/$defs/vector3"
        },
        "bbox_max": {
          "$ref": "#/$defs/vector3"
        },
        "centroid": {
          "$ref": "#/$defs/vector3"
        },
        "appearance": {
          "enum": [
            "none",
            "vertex_color",
            "texture"
          ]
        },
        "geometry_status": {
          "enum": [
            "observed_partial",
            "reconstructed_surface"
          ]
        },
        "evidence_frame_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "instance_id",
        "mesh_uri",
        "mesh_format",
        "material_uri",
        "texture_uris",
        "world_from_object",
        "bbox_min",
        "bbox_max",
        "centroid",
        "appearance",
        "geometry_status",
        "evidence_frame_ids"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "capture_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "capture_id",
        "frame_id"
      ],
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "added",
            "removed",
            "moved",
            "shape_changed",
            "unchanged",
            "unknown"
          ]
        },
        "before_instance_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "after_instance_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "displacement_in_baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/vector3"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "type",
        "before_instance_id",
        "after_instance_id",
        "confidence",
        "displacement_in_baseline",
        "reason",
        "evidence"
      ],
      "additionalProperties": false
    },
    "registration": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "ok",
            "insufficient_overlap",
            "failed"
          ]
        },
        "model": {
          "enum": [
            "SE3",
            "Sim3"
          ]
        },
        "baseline_from_current": {
          "anyOf": [
            {
              "$ref": "#/$defs/matrix4"
            },
            {
              "type": "null"
            }
          ]
        },
        "fitness": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "rmse": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "model",
        "baseline_from_current",
        "fitness",
        "rmse",
        "reason"
      ],
      "additionalProperties": false
    },
    "keyframe": {
      "type": "object",
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_id": {
          "type": "string",
